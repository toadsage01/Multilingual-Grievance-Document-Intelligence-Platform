# Django
DJANGO_SECRET_KEY=change-me-to-a-real-50-char-secret
DJANGO_DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (Neon free tier works fine; must support pgvector)
DATABASE_URL=postgresql://setu:setu@localhost:5432/setu

# Redis (Upstash free tier is fine)
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Embeddings
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
DEFAULT_LANGUAGE=en

# LLM providers — pick whichever has a key set, the other is the fallback
LLM_PRIMARY_PROVIDER=groq
LLM_FALLBACK_PROVIDER=gemini
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Circuit breaker
LLM_CIRCUIT_FAILURE_THRESHOLD=5
LLM_CIRCUIT_COOLDOWN_SECONDS=60

# Retrieval
RAG_TOP_K=5
RAG_CONFIDENCE_THRESHOLD=0.72

# CORS (only used by the dev settings module)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Bhashini translation pipeline (optional — only wired if key set)
BHASHINI_API_KEY=
BHASHINI_USER_ID=
